# Banco de dados (Render fornece a URL ao criar o Postgres)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/social_media_manager
# "true" liga SSL na conexão com o banco (use com a URL externa do Postgres; a interna do Render dispensa).
DATABASE_SSL=

# Acesso ao app. Deixe APP_PASSWORD vazia para definir a senha na tela de primeiro acesso (fica no banco).
# Se preenchida, ela vale no lugar da senha do banco. SESSION_SECRET é um texto longo e aleatório.
APP_PASSWORD=
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Google Drive: JSON da conta de serviço (texto do JSON ou o JSON em base64).
# A pasta de cada cliente é compartilhada, como Editor, com o e-mail da conta de serviço (Leitor basta só para ler).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Legendas e Planejamento Editorial com IA. Sem nenhuma das duas, o botão não aparece e só funciona "Copiar pedido para a IA".
# Se GEMINI_API_KEY estiver definida, ela tem prioridade nas legendas e liga também o Planejamento Editorial.
GEMINI_API_KEY=
# Opcional: força um modelo do Gemini (ex.: gemini-2.5-flash-lite). Vazio = o app tenta uma lista de modelos em ordem.
GEMINI_MODEL=
# Alternativa para legendas com IA (Claude Console). Nunca coloque chaves no repositório.
ANTHROPIC_API_KEY=

# Publicação pelo app (Instagram e Facebook). Tudo isto vai só no Render, nunca no repositório.
# Texto longo e aleatório que criptografa os tokens das contas no banco. Se mudar, as contas precisam ser conectadas de novo.
TOKEN_ENC_KEY=
# Endereço público do app, sem barra no fim. A Meta usa para baixar imagens na hora de publicar.
APP_URL=https://app.ebuks.com.br
# Dados do app criado em developers.facebook.com (a conexão das contas usa estes dois).
META_APP_ID=
META_APP_SECRET=
# Só se o app da Meta usar "Login do Facebook para Empresas": ID da configuração de login (usa config_id em vez de scope).
META_LOGIN_CONFIG_ID=

# Dados do app criado em linkedin.com/developers (produtos "Share on LinkedIn" e "Sign In with LinkedIn using OpenID Connect").
# O endereço de retorno APP_URL/api/linkedin/callback precisa estar em "Authorized redirect URLs" do app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Opcional: versão da API de publicação do LinkedIn (AAAAMM). Padrão 202611.
LINKEDIN_API_VERSION=

# Dados do app criado em developers.tiktok.com (produtos "Login Kit" e "Content Posting API"; escopos user.info.basic e video.upload).
# O endereço de retorno APP_URL/api/tiktok/callback precisa estar em "Redirect URI" do Login Kit. Para TikTok Fotos, o endereço
# do app (APP_URL) também precisa estar verificado em "Manage URL properties" (o TikTok só baixa fotos de endereço verificado).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pasta do Drive onde o botão "Criar diretório" cria as pastas dos clientes (opcional; também dá para definir em Configurações).
# Precisa estar compartilhada como Editor com a conta de serviço.
DRIVE_ROOT_FOLDER_ID=
# Opcional: e-mail de contato exibido na página pública /privacidade
PRIVACY_CONTACT_EMAIL=

# Aviso por e-mail quando a publicação automática falha ou perde o horário (Resend, resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Opcional. Padrão: "Social Media Manager <onboarding@resend.dev>" (só entrega ao e-mail dono da conta no Resend)
NOTIFY_EMAIL_FROM=
# Opcional: 1 desliga o relógio da publicação automática neste processo
AUTO_PUBLISH_DISABLED=
